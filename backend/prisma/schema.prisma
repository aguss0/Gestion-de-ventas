generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Cliente {
  id         Int      @id @default(autoincrement())
  nombre     String
  cuit       String?
  direccion  String?
  barrio     String?
  telefono   String?
  email      String?
  tipo       String?
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now()) @map("creado_en")
  vendedorId Int?     @map("vendedor_id")
  comisionPct Float?  @map("comision_pct")
  comisionMiguelPct  Float @default(0) @map("comision_miguel_pct")
  comisionGerardoPct Float @default(0) @map("comision_gerardo_pct")
  comisionTurkoPct   Float @default(0) @map("comision_turko_pct")

  vendedor Vendedor? @relation(fields: [vendedorId], references: [id])
  pedidos  Pedido[]
  comisionesVendedores ClienteComision[]

  @@map("clientes")
}

model Articulo {
  id          Int      @id @default(autoincrement())
  codigo      String?  @unique
  nombre      String
  descripcion String?
  unidadCaja  String?  @map("unidad_caja")
  precio      Float
  activo      Boolean  @default(true)
  precioOnline Float? @map("precio_online")
  publicarOnline Boolean @default(false) @map("publicar_online")
  categoriaOnline String? @map("categoria_online")
  imagenUrl String? @map("imagen_url")
  manejaStock Boolean  @default(false) @map("maneja_stock")
  stock       Int      @default(0)
  stockMinimo Int      @default(0) @map("stock_minimo")
  creadoEn    DateTime @default(now()) @map("creado_en")
  unidadMedida String? @map("unidad_medida")
  detallePedidos DetallePedido[]
  compras CompraStock[]
  descartableId Int? @map("descartable_id")
  presentacion String?
  descartable Descartable? @relation(fields: [descartableId], references: [id], onDelete: Restrict)
  dieteticaId Int? @map("dietetica_id")
  dietetica Dietetica? @relation(fields: [dieteticaId], references: [id], onDelete: Restrict)

  @@unique([descartableId, presentacion])
  @@unique([dieteticaId, presentacion])

  @@map("articulos")
}

model Descartable {
  id Int @id @default(autoincrement())
  codigo String @unique
  nombre String
  categoria String
  costoBulto Float @map("costo_bulto")
  unidadesBulto Int? @map("unidades_bulto")
  unidadesManual Boolean @default(false) @map("unidades_manual")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  articulos Articulo[]

  @@map("descartables")
}

model Dietetica {
  id Int @id @default(autoincrement())
  codigo String @unique
  nombre String
  categoria String
  costoUnidad Float? @map("costo_unidad")
  costoMayorista Float? @map("costo_mayorista")
  costoBulto Float? @map("costo_bulto")
  unidadesBulto Float? @map("unidades_bulto")
  presentacion String
  tipoBulto String @default("unitario") @map("tipo_bulto")
  sinStock Boolean @default(false) @map("sin_stock")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  articulos Articulo[]
  @@map("dietetica")
}

model Vendedor {
  id          Int      @id @default(autoincrement())
  nombre      String
  email       String?  @unique
  telefono    String?
  comisionPct Float    @default(6) @map("comision_pct")
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")

  clientes   Cliente[]
  pedidos    Pedido[]
  comisiones Comision[]
  clientesComision ClienteComision[]
  comisionesPedidos PedidoComisionVendedor[]

  @@map("vendedores")
}

model Pedido {
  id            Int      @id @default(autoincrement())
  nroOrden      Int      @unique @map("nro_orden")
  fecha         DateTime @default(now())
  clienteId     Int      @map("cliente_id")
  vendedorId    Int?     @map("vendedor_id")
  total         Float    @default(0)
  totalPagado   Float    @default(0) @map("total_pagado")
  saldo         Float    @default(0)
  observaciones String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  comisionMiguelPct  Float? @map("comision_miguel_pct")
  comisionGerardoPct Float? @map("comision_gerardo_pct")
  comisionTurkoPct   Float? @map("comision_turko_pct")

  cliente  Cliente         @relation(fields: [clienteId], references: [id])
  vendedor Vendedor?       @relation(fields: [vendedorId], references: [id])
  detalle  DetallePedido[]
  pagos    Pago[]
  comision Comision?
  comisionesVendedores PedidoComisionVendedor[]

  @@map("pedidos")
}

model DetallePedido {
  id               Int     @id @default(autoincrement())
  pedidoId         Int     @map("pedido_id")
  articuloId       Int     @map("articulo_id")
  cantidad         Int
  precio           Float
  subtotal         Float
  faltante         Boolean @default(false)
  cantidadFaltante Int     @default(0) @map("cantidad_faltante")
  observaciones    String?

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  articulo Articulo @relation(fields: [articuloId], references: [id])

  @@map("detalle_pedidos")
}
model Pago {
  id            Int      @id @default(autoincrement())
  pedidoId      Int      @map("pedido_id")
  clienteId     Int      @map("cliente_id")
  fecha         DateTime @default(now())
  metodo        String
  monto         Float
  observaciones String?
  creadoEn      DateTime @default(now()) @map("creado_en")

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@map("pagos")
}

model Comision {
  id              Int      @id @default(autoincrement())
  pedidoId        Int      @unique @map("pedido_id")
  vendedorId      Int      @map("vendedor_id")
  importe         Float
  comisionMiguel  Float    @default(0) @map("comision_miguel")
  comisionGerardo Float    @default(0) @map("comision_gerardo")
  comisionTurko   Float    @default(0) @map("comision_turko")
  plusTurko       Float    @default(0) @map("plus_turko")
  cobrado         Boolean  @default(false)
  fechaCobro      DateTime? @map("fecha_cobro")
  creadoEn        DateTime @default(now()) @map("creado_en")

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@map("comisiones")
}

model ClienteComision {
  id         Int   @id @default(autoincrement())
  clienteId  Int   @map("cliente_id")
  vendedorId Int   @map("vendedor_id")
  porcentaje Float

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Restrict)

  @@unique([clienteId, vendedorId])
  @@map("cliente_comisiones")
}

model PedidoComisionVendedor {
  id         Int      @id @default(autoincrement())
  pedidoId   Int      @map("pedido_id")
  vendedorId Int      @map("vendedor_id")
  porcentaje Float
  importe    Float    @default(0)
  monto      Float    @default(0)
  cobrado    Boolean  @default(false)
  fechaCobro DateTime? @map("fecha_cobro")
  creadoEn   DateTime @default(now()) @map("creado_en")

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  vendedor Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Restrict)

  @@unique([pedidoId, vendedorId])
  @@map("pedido_comisiones_vendedores")
}

model CompraStock {
  id            Int      @id @default(autoincrement())
  articuloId    Int      @map("articulo_id")
  cantidad      Int
  precioUnitario Float   @map("precio_unitario")
  total         Float
  proveedor     String?
  fecha         DateTime @default(now())
  observaciones String?
  creadoEn      DateTime @default(now()) @map("creado_en")

  articulo Articulo @relation(fields: [articuloId], references: [id])

  @@map("compras_stock")
}

model HistorialListaPrecio {
  id             Int      @id @default(autoincrement())
  tipo           String
  recargoUnidad  Float    @map("recargo_unidad")
  recargoBulto   Float    @map("recargo_bulto")
  cantidad       Int
  contenido      String
  vendedor       String   @default("Miguel Sanchez")
  telefono       String   @default("3512590512")
  email          String   @default("j.miguel.sanchez.23@gmail.com")
  creadoEn       DateTime @default(now()) @map("creado_en")

  @@index([tipo, creadoEn])

  @@map("historial_listas_precios")
}
