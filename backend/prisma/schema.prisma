generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id         Int      @id @default(autoincrement())
  nombre     String
  cuit       String?
  direccion  String?
  barrio     String?
  telefono   String?
  email      String?  @unique
  tipo       String?
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now()) @map("creado_en")
  vendedorId Int?     @map("vendedor_id")

  vendedor Vendedor? @relation(fields: [vendedorId], references: [id])
  pedidos  Pedido[]

  @@map("clientes")
}

model Articulo {
  id          Int      @id @default(autoincrement())
  codigo      String?  @unique
  nombre      String
  descripcion String?
  unidadCaja  String?  @map("unidad_caja")
  precio      Decimal  @db.Decimal(12, 2)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")

  detallePedidos DetallePedido[]

  @@map("articulos")
}

model Vendedor {
  id          Int      @id @default(autoincrement())
  nombre      String
  email       String?  @unique
  telefono    String?
  comisionPct Float    @default(6) @map("comision_pct")
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")

  clientes   Cliente[]
  pedidos    Pedido[]
  comisiones Comision[]

  @@map("vendedores")
}

model Pedido {
  id            Int      @id @default(autoincrement())
  nroOrden      Int      @unique @map("nro_orden")
  fecha         DateTime @default(now())
  clienteId     Int      @map("cliente_id")
  vendedorId    Int?     @map("vendedor_id")
  total         Float    @default(0)
  totalPagado   Float    @default(0) @map("total_pagado")
  saldo         Float    @default(0)
  observaciones String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")

  cliente  Cliente         @relation(fields: [clienteId], references: [id])
  vendedor Vendedor?       @relation(fields: [vendedorId], references: [id])
  detalle  DetallePedido[]
  pagos    Pago[]
  comision Comision?

  @@map("pedidos")
}

model DetallePedido {
  id         Int     @id @default(autoincrement())
  pedidoId   Int     @map("pedido_id")
  articuloId Int     @map("articulo_id")
  cantidad   Int
  precio     Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  articulo Articulo @relation(fields: [articuloId], references: [id])

  @@map("detalle_pedidos")
}

model Pago {
  id            Int      @id @default(autoincrement())
  pedidoId      Int      @map("pedido_id")
  clienteId     Int      @map("cliente_id")
  fecha         DateTime @default(now())
  metodo        String
  monto         Float
  observaciones String?
  creadoEn      DateTime @default(now()) @map("creado_en")

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@map("pagos")
}

model Comision {
  id              Int      @id @default(autoincrement())
  pedidoId        Int      @unique @map("pedido_id")
  vendedorId      Int      @map("vendedor_id")
  importe         Float
  comisionMiguel  Float    @default(0) @map("comision_miguel")
  comisionGerardo Float    @default(0) @map("comision_gerardo")
  comisionTurko   Float    @default(0) @map("comision_turko")
  plusTurko       Float    @default(0) @map("plus_turko")
  metodo          String?
  creadoEn        DateTime @default(now()) @map("creado_en")

  pedido   Pedido   @relation(fields: [pedidoId], references: [id])
  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@map("comisiones")
}